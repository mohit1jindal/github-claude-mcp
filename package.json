{
  "name": "github-claude-mcp",
  "version": "1.0.0",
  "description": "A two-way MCP bridge between Claude and GitHub — Claude gets GitHub tools, GitHub gets Claude-powered automation.",
  "main": "dist/index.js",
  "bin": {
    "github-claude-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "build:action": "tsc -p tsconfig.action.json && ncc build github-action/dist/index.js -o github-action/dist/bundle"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "github",
    "claude",
    "anthropic",
    "ai",
    "automation",
    "developer-tools",
    "pr-review",
    "github-actions"
  ],
  "author": "Mohit Jindal",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@octokit/rest": "^21.1.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.8.3"
  }
}
